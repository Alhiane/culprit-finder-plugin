---
import logo from '../assets/brand/culprit-finder-logo.svg';
import { DOWNLOAD_URL } from '../config';

const path = Astro.url.pathname;
const links = [
	{ href: '/how-it-works/', label: 'How it works' },
	{ href: '/docs/', label: 'Docs' },
	{ href: '/guides/', label: 'Guides' },
];
const current = (href: string) => (path.startsWith(href) ? 'page' : undefined);
---
<header class="site-header">
	<div class="wrap">
		<a class="brand" href="/" aria-label="Culprit Finder home">
			<img src={logo.src} width={logo.width} height={logo.height} alt="Culprit Finder" />
		</a>
		<nav class="nav" aria-label="Main">
			{links.map((l) => <a href={l.href} aria-current={current(l.href)}>{l.label}</a>)}
			<a class="btn btn-sm" href={DOWNLOAD_URL}>Download free</a>
		</nav>
		<details class="menu">
			<summary aria-label="Open menu">Menu</summary>
			<ul>
				{links.map((l) => <li><a href={l.href} aria-current={current(l.href)}>{l.label}</a></li>)}
				<li><a href={DOWNLOAD_URL}>Download free</a></li>
			</ul>
		</details>
	</div>
</header>
