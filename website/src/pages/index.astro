---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CopyButton from '../components/CopyButton.astro';
import symbol from '../assets/brand/culprit-finder-symbol.svg';
import shot1 from '../assets/screenshots/screenshot-1.png';
import shot2 from '../assets/screenshots/screenshot-2.png';
import shot3 from '../assets/screenshots/screenshot-3.png';
import shot4 from '../assets/screenshots/screenshot-4.png';
import { DOWNLOAD_URL, SITE_NAME, SITE_URL } from '../config';

const shots = [
	{ img: shot1, caption: 'Pick plugins to keep on and save your two safety links.', alt: 'The Culprit Finder setup screen with plugin checkboxes and two safety links.' },
	{ img: shot2, caption: 'One question per step: is the problem still there?', alt: 'A troubleshooting step asking whether the problem is still there, with Yes and No buttons.' },
	{ img: shot3, caption: 'Answer from the toolbar on any page.', alt: 'A website page with the purple Culprit Finder toolbar menu open.' },
	{ img: shot4, caption: 'The culprit, what to do next, and a report ready for any support forum.', alt: 'A result page naming Acme Invoices as the plugin causing the problem.' },
];

const faq = [
	{ q: 'Will my visitors notice anything?', a: 'No. Plugins are switched off only for your own browser while you are logged in. Visitors and other administrators always get every plugin.' },
	{ q: 'Does it deactivate my plugins?', a: 'No. Your real plugin settings never change. Culprit Finder only decides which plugins load for your browser during a session.' },
	{ q: 'What if a step breaks my site?', a: 'That usually means the plugins on in that step are the problem, so answer Yes. Your bookmarked control panel link always loads, even when pages show a critical error.' },
	{ q: 'How do I stop?', a: 'Press Exit, open your emergency exit link (it works even when logged out), or simply wait: troubleshooting ends by itself after 60 minutes without an answer.' },
	{ q: 'Does any data leave my site?', a: 'No. The plugin makes no external requests and has no tracking. Results stay on your site, and the report contains no site address, user names or emails.' },
	{ q: 'What can’t it test?', a: 'Your theme, must-use plugins, drop-ins such as object-cache.php, and server settings. If the problem stays with every plugin off, the result says so.' },
];

const report = `### Plugin conflict report (Culprit Finder 0.1.0)
Result: Conflict between two plugins
- Fabrikam Cache 3.1.0
- Tailspin Slider 1.8.5
The problem appears only when both are active.

Environment
- WordPress 7.1.2, PHP 8.3.12
- Theme: Twenty Twenty-Five 1.5
- Plugins tested: 10 (kept on: Acme Shop 9.1.0)
- Not tested: must-use plugins, drop-ins, theme
- Multisite: no

Found in 10 answers on 2026-10-03 (UTC).`;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: SITE_NAME,
	description: 'A WordPress plugin that finds the plugin, or the two plugins, behind a problem by switching plugins off for your browser only.',
	applicationCategory: 'DeveloperApplication',
	operatingSystem: 'WordPress',
	url: SITE_URL,
	image: `${SITE_URL}/og-image.png`,
	license: 'https://www.gnu.org/licenses/gpl-2.0.html',
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---
<Base title={SITE_NAME} description="Find the plugin that broke your WordPress site. Plugins are switched off for your browser only, so visitors never notice. Free." jsonLd={jsonLd}>
	<section class="hero section">
		<div class="wrap hero-grid">
			<div>
				<img class="hero-symbol" src={symbol.src} width="72" height="89" alt="" />
				<h1>Find the plugin that broke your site.</h1>
				<p class="lead">Visitors never notice. Free for WordPress.</p>
				<div class="cta-row">
					<a class="btn" href={DOWNLOAD_URL}>Download free</a>
					<a class="btn btn-ghost" href="/how-it-works/">See how it works</a>
				</div>
			</div>
			<figure class="hero-shot">
				<Image src={shot2} alt={shots[1].alt} widths={[640, 960, 1280]} sizes="(max-width: 52rem) 100vw, 36rem" loading="eager" />
			</figure>
		</div>
	</section>

	<section class="section section-alt" aria-labelledby="old-way">
		<div class="wrap narrow">
			<p class="eyebrow">The old way hurts</p>
			<h2 id="old-way">"Deactivate everything, then turn them back on one by one."</h2>
			<p>That's the standard advice when a site breaks. On a live site it means:</p>
			<ul class="plain-list">
				<li>Shoppers hit an empty cart or a broken checkout while you test.</li>
				<li>Forms, logins and memberships stop working for real visitors.</li>
				<li>With 30 plugins it takes an hour, and you still might miss two plugins that only fail together.</li>
			</ul>
		</div>
	</section>

	<section class="section" aria-labelledby="how">
		<div class="wrap">
			<p class="eyebrow">How it works</p>
			<h2 id="how">Three steps, a few minutes</h2>
			<ol class="steps grid grid-3">
				<li><h3>We switch plugins off, for you only</h3><p>Only your browser sees the change. Everyone else gets the normal site.</p></li>
				<li><h3>You check the page and answer</h3><p>Is the problem still there? Yes or No. About 7 answers for 30 plugins.</p></li>
				<li><h3>We name the culprit</h3><p>One plugin, or two that clash, with a report you can paste into a support forum.</p></li>
			</ol>
			<p><a href="/how-it-works/">How the search works</a></p>
		</div>
	</section>

	<section class="section section-alt" aria-labelledby="see-it">
		<div class="wrap">
			<p class="eyebrow">See it</p>
			<h2 id="see-it">It lives in your WordPress admin</h2>
			<div class="grid grid-2 shots">
				{shots.map((s) => (
					<figure>
						<Image src={s.img} alt={s.alt} widths={[480, 720, 960]} sizes="(max-width: 52rem) 100vw, 34rem" />
						<figcaption>{s.caption}</figcaption>
					</figure>
				))}
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="safe">
		<div class="wrap">
			<p class="eyebrow">Why it's safe</p>
			<h2 id="safe">Your visitors keep the real site</h2>
			<div class="grid grid-2">
				<div class="card"><h3>Visitors and other admins see nothing</h3><p>Plugins are switched off only for requests from your own logged-in browser. Pages filtered for you are marked as not cacheable.</p></div>
				<div class="card"><h3>Nothing is deactivated</h3><p>Your real list of active plugins never changes, not even if another plugin tries to change it during a session.</p></div>
				<div class="card"><h3>Nothing leaves your site</h3><p>No external requests, no tracking, no accounts. Your last 10 results stay in your own database.</p></div>
				<div class="card"><h3>Several ways out</h3><p>An Exit button, an emergency exit link that works even when logged out, and an automatic end after 60 minutes without an answer.</p></div>
			</div>
		</div>
	</section>

	<section class="section section-dark" aria-labelledby="pairs">
		<div class="wrap pair-grid">
			<div>
				<p class="eyebrow" style="color:#e6d9f2">Catches two-plugin conflicts</p>
				<h2 id="pairs">Some problems need two plugins</h2>
				<p>Two plugins can each work fine alone and only break together, for example when both define the same function. Turning plugins on one by one often misses that, because each half of your list looks healthy.</p>
				<p>Culprit Finder first finds the plugin that completes the problem, then searches the plugins before it for its partner, and finally checks the two together. If more than two plugins are involved, it tells you instead of guessing.</p>
			</div>
			<svg class="pair-diagram" viewBox="0 0 420 260" role="img" aria-labelledby="pair-title pair-desc">
				<title id="pair-title">Two plugins that only fail together</title>
				<desc id="pair-desc">Plugin A alone works, plugin B alone works, both together cause an error.</desc>
				<g font-family="system-ui, sans-serif" font-size="15">
					<rect x="10" y="20" width="120" height="56" rx="8" fill="#2e2238" stroke="#925FBB"/>
					<text x="70" y="53" fill="#fff" text-anchor="middle">Plugin A</text>
					<text x="160" y="53" fill="#e6d9f2">alone: works</text>
					<rect x="10" y="100" width="120" height="56" rx="8" fill="#2e2238" stroke="#925FBB"/>
					<text x="70" y="133" fill="#fff" text-anchor="middle">Plugin B</text>
					<text x="160" y="133" fill="#e6d9f2">alone: works</text>
					<rect x="10" y="184" width="250" height="56" rx="8" fill="#925FBB"/>
					<text x="135" y="217" fill="#fff" text-anchor="middle">A + B together</text>
					<text x="276" y="217" fill="#fff" font-weight="700">error</text>
				</g>
			</svg>
		</div>
	</section>

	<section class="section" aria-labelledby="report-title">
		<div class="wrap narrow">
			<p class="eyebrow">A report support teams love</p>
			<h2 id="report-title">Paste it, and get help faster</h2>
			<p>Forum volunteers and plugin authors always ask the same questions. The report answers them, and contains no site address, user names or emails.</p>
			<pre class="report" id="example-report">{report}</pre>
			<CopyButton target="example-report" label="Copy example report" />
		</div>
	</section>

	<section class="section section-alt" aria-labelledby="faq">
		<div class="wrap narrow">
			<h2 id="faq">Questions</h2>
			{faq.map((f) => (
				<details class="faq">
					<summary>{f.q}</summary>
					<p>{f.a}</p>
				</details>
			))}
			<p><a href="/docs/help/faq/">More answers in the docs</a></p>
		</div>
	</section>

	<section class="section" aria-labelledby="final">
		<div class="wrap narrow final">
			<h2 id="final">Find the culprit in a few minutes</h2>
			<p class="lead">Free, open source, and your visitors never notice.</p>
			<div class="cta-row">
				<a class="btn" href={DOWNLOAD_URL}>Download free</a>
				<a class="btn btn-ghost" href="/docs/getting-started/install/">Read the install guide</a>
			</div>
		</div>
	</section>
</Base>

<style>
	.hero { padding-block: clamp(3rem, 8vw, 6rem); background: linear-gradient(180deg, var(--cf-purple-tint), #fff 85%); }
	.hero-grid { display: grid; gap: 2.5rem; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); align-items: center; }
	.hero-symbol { display: block; margin-bottom: 1.25rem; }
	.cta-row { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
	.hero-shot, .shots figure { margin: 0; }
	.hero-shot :global(img), .shots :global(img) { border: 1px solid var(--cf-border); border-radius: var(--cf-radius); box-shadow: 0 18px 40px rgb(31 26 36 / 0.12); display: block; width: 100%; height: auto; }
	.shots :global(img) { aspect-ratio: 16 / 10; object-fit: cover; object-position: top left; }
	.shots figcaption { margin-top: 0.75rem; color: var(--cf-muted); }
	.plain-list { padding-left: 1.3rem; }
	.plain-list li { margin-bottom: 0.5rem; }
	.steps li h3 { margin-top: 0.2rem; }
	.pair-grid { display: grid; gap: 2.5rem; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); align-items: center; }
	.pair-diagram { width: 100%; max-width: 26rem; justify-self: center; }
	.report { background: var(--cf-dark); color: #f3ecf8; padding: 1.25rem; border-radius: var(--cf-radius); overflow-x: auto; font: 0.9rem/1.6 var(--cf-mono); white-space: pre-wrap; }
	.faq { border-bottom: 1px solid var(--cf-border); padding-block: 0.25rem; }
	.faq summary { cursor: pointer; font-weight: 700; padding-block: 0.85rem; min-height: 44px; }
	.faq p { margin-top: 0; }
	.final { text-align: center; }
	.final .lead { margin-inline: auto; }
	.final .cta-row { justify-content: center; }
</style>
