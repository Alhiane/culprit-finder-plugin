---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Guides" description="Practical guides for fixing a broken WordPress site: finding the plugin behind a problem, the critical error message, and what to do after a bad update.">
	<section class="section">
		<div class="wrap narrow">
			<p class="eyebrow">Guides</p>
			<h1>When your WordPress site breaks</h1>
			<p class="lead">Calm, practical steps for the most common problems.</p>
			<ul class="guide-list">
				{guides.map((g) => (
					<li class="card">
						<h2><a href={`/guides/${g.id}/`}>{g.data.title}</a></h2>
						<p>{g.data.description}</p>
					</li>
				))}
			</ul>
		</div>
	</section>
</Base>
<style>
	.guide-list { list-style: none; padding: 0; display: grid; gap: 1.25rem; }
	.guide-list h2 { font-size: 1.35rem; margin-bottom: 0.5rem; }
	.guide-list p { margin: 0; color: var(--cf-muted); }
</style>
